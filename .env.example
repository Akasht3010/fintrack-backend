# Database
# Run `docker compose up -d` to start a local Postgres instance matching these defaults
DATABASE_URL=postgresql://fintrack:fintrack@localhost:5433/fintrack

# Auth
# Required — the app won't start without it. Generate a real value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS — comma-separated list of allowed browser origins. The RN mobile app
# isn't a browser client so it doesn't need an entry here; only add origins
# for browser-based clients (e.g. Expo web dev server, a future web app).
# Leave empty/unset to allow no cross-origin browser access.
CORS_ORIGINS=

# Login OTP (emailed 2FA code after password check)
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Encrypts secrets at rest (currently: Gmail refresh tokens). Not required to
# start the app — only the Gmail-linking routes need it — but set it before
# any real user connects Gmail. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# SMTP — used to send login OTP emails. Leave unset for local dev: the OTP
# is printed to the backend console instead of being sent. For Gmail, use an
# App Password (myaccount.google.com/apppasswords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# Google OAuth (Web client — used for the backend-mediated OAuth flow)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Public origin Google redirects the user's browser back to after consent.
# Both /api/auth/google/callback and /api/gmail/callback are built from this,
# and it must be registered (with those two paths) as an authorized redirect
# URI on the Web client in Google Cloud Console. Must be https (or
# http://localhost for a purely-local test).
#
# IMPORTANT — in production this must be a host the *end user's phone* can
# resolve on any network, because Google redirects Safari/Chrome straight to
# it. The mobile app reaches the API through the Cloudflare Worker proxy
# (fintrack-api-proxy), never the Railway origin directly, and some mobile
# carriers (e.g. Jio) can't resolve *.up.railway.app — a browser redirect
# there fails with "server can't be found". So point this at the PROXY, not
# the raw Railway URL:
#   PUBLIC_BASE_URL=https://fintrack-api-proxy.fintrack-proxy.workers.dev
# The proxy forwards every path to Railway and passes OAuth 3xx redirects
# through untouched, so the callback still lands on the backend.
#
# Local dev: use your ngrok URL (e.g. https://<name>.ngrok-free.dev) and add
# {PUBLIC_BASE_URL}/api/auth/google/callback + /api/gmail/callback to the same
# Web client. ngrok URLs change on every restart unless you have a static
# domain, so you'll re-register them each session.
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.dev

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Environment
ENV=development

# Admin monitoring dashboard (fintrack-monitor) — required header
# (X-Admin-Key) to call /api/admin/*. Leave unset to disable those routes.
#   python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=
