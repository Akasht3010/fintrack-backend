# Database
# Run `docker compose up -d` to start a local Postgres instance matching these defaults
DATABASE_URL=postgresql://fintrack:fintrack@localhost:5433/fintrack

# Auth
# Required — the app won't start without it. Generate a real value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS — comma-separated list of allowed browser origins. The RN mobile app
# isn't a browser client so it doesn't need an entry here; only add origins
# for browser-based clients (e.g. Expo web dev server, a future web app).
# Leave empty/unset to allow no cross-origin browser access.
CORS_ORIGINS=

# Login OTP (emailed 2FA code after password check)
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Encrypts secrets at rest (currently: Gmail refresh tokens). Not required to
# start the app — only the Gmail-linking routes need it — but set it before
# any real user connects Gmail. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# SMTP — used to send login OTP emails. Leave unset for local dev: the OTP
# is printed to the backend console instead of being sent. For Gmail, use an
# App Password (myaccount.google.com/apppasswords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# Google OAuth (Web client — used for the backend-mediated OAuth flow)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Public URL Google redirects back to after consent (must be https, or
# http://localhost for testing) — set this to your ngrok URL when testing
# Google sign-in locally, and register {PUBLIC_BASE_URL}/api/auth/google/callback
# as an authorized redirect URI on the Web client in Google Cloud Console.
PUBLIC_BASE_URL=http://localhost:8000

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Environment
ENV=development

# Admin monitoring dashboard (fintrack-monitor) — required header
# (X-Admin-Key) to call /api/admin/*. Leave unset to disable those routes.
#   python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=
